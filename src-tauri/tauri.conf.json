{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Assistant",
  "version": "0.1.0",
  "identifier": "com.portable.aiassistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 http://127.0.0.1:8080 http://localhost:8080 ws://localhost:*;"
    },
    "windows": [
      {
        "label": "main",
        "title": "AI Assistant — Portable Offline Tool Agent",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 420,
        "height": 280,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/llama-server",
      "binaries/backend"
    ],
    "resources": [
      "binaries/*.dll"
    ]
  }
}
